<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Rules for Dynamic Cornerstones' stat sweep. Edit or patch this file to change
    which stats become cornerstones; no recompile needed.
  -->

  <DynamicCornerstones.CornerstoneRulesDef>
    <defName>DynCS_Rules</defName>
    <label>dynamic cornerstones rules</label>

    <!-- Stat categories eligible for cornerstone generation. -->
    <categories>
      <li>BasicsPawn</li>
      <li>BasicsPawnImportant</li>
      <li>Mechanitor</li>
      <li>PawnCombat</li>
      <li>PawnWork</li>
      <li>PawnSocial</li>
      <li>PawnMisc</li>
      <li>PawnHealth</li>
      <li>PawnFood</li>
      <li>PawnResistances</li>
      <li>PawnPsyfocus</li>
      <li>Meditation</li>
    </categories>

    <!-- Stats where a smaller number is the buff; the generated modifier is inverted. -->
    <useNegativeValue>
      <li>AimingDelayFactor</li>
      <li>MeleeCooldownFactor</li>
      <li>RangedCooldownFactor</li>
      <li>StaggerDurationFactor</li>
      <li>MortarMissRadiusFactor</li>
      <li>PawnTrapSpringChance</li>
      <li>MechEnergyUsageFactor</li>
      <li>FilthRate</li>
      <li>CertaintyLossFactor</li>
      <li>SlaveSuppressionFallRate</li>
      <li>PsychicEntropyGain</li>
      <li>HungerRateMultiplier</li>
    </useNegativeValue>

    <!-- Stats never offered as cornerstones. Unknown defNames are harmless: they simply never match, so entries for inactive mods can stay. -->
    <statBlacklist>
      <li>CancerRate</li>
      <li>VREA_MemorySpaceDrainMultiplier</li>
      <li>RE_ChemicalSusceptibility</li>
      <li>VQE_LifespanDrainSpeed</li>
